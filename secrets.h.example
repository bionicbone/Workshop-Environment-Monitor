// secrets.h.example
// Workshop Environmental Monitor — credential template
//
// SETUP:
//   1. Copy this file to "secrets.h" (same folder).
//   2. Fill in your own WiFi / MQTT details below.
//   3. secrets.h is git-ignored, so your real credentials never get committed.
//
// Do NOT put real credentials in this .example file — it IS committed to git.

#ifndef _SECRETS_h
#define _SECRETS_h

#include <WiFi.h>   // for IPAddress

#define WIFI_HOSTNAME   "workshop-environmental-monitor"
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"
#define BROKER_ADDR     IPAddress(192, 168, 1, 2)   // your MQTT broker IP
#define MQTT_USERNAME   "YOUR_MQTT_USERNAME"
#define MQTT_PASSWORD   "YOUR_MQTT_PASSWORD"

#endif
